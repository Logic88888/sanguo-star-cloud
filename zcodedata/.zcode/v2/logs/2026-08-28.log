\\\"ccapi-home-eyebrow\\\"\\u003e\\u003cspan class=\\\"ccapi-home-i18n-zh\\\"\\u003e统一入口\\u003c/span\\u003e\\u003cspan class=\\\"ccapi-home-i18n-en\\\"\\u003eBase URL\\u003c/span\\u003e\\u003c/span\\u003e\\n          \\u003ch2 class=\\\"ccapi-home-api-focus-title\\\" id=\\\"ccapi-home-api-focus-title\\\"\\u003e\\u003cspan class=\\\"ccapi-home-i18n-zh\\\"\\u003e统一 API 地址\\u003c/span\\u003e\\u003cspan class=\\\"ccapi-home-i18n-en\\\"\\u003eOne Base URL for every client\\u003c/span\\u003e\\u003c/h2\\u003e\\n          \\u003cp class=\\\"ccapi-home-api-focus-text\\\"\\u003e\\u003cspan class=\\\"ccapi-home-i18n-zh\\\"\\u003e复制地址并配置到兼容的客户端或开发工具中。\\u003c/span\\u003e\\u003cspan class=\\\"ccapi-home-i18n-en\\\"\\u003eCopy the address into any compatible client or developer tool.\\u003c/span\\u003e\\u003c/p\\u003e\\n        \\u003c/div\\u003e\\n\\n        \\u003cdiv\\u003e\\n          \\u003cdiv class=\\\"ccapi-home-api-focus-control\\\"\\u003e\\n            \\u003ccode class=\\\"ccapi-home-api-focus-code\\\"\\u003ehttps://api.xiebc.cc\\u003c/code\\u003e\\n            \\u003cbutton class=\\\"ccapi-home-copy-button\\\" type=\\\"button\\\" data-ccapi-copy=\\\"https://api.xiebc.cc\\\" popovertarget=\\\"ccapi-home-copy-help\\\" aria-label=\\\"复制统一 API 地址\\\"\\u003e\\n              \\u003csvg class=\\\"ccapi-home-icon-svg ccapi-home-copy-icon\\\" viewBox=\\\"0 0 24 24\\\" aria-hidden=\\\"true\\\" focusable=\\\"false\\\"\\u003e\\n                \\u003crect x=\\\"8\\\" y=\\\"8\\\" width=\\\"11\\\" height=\\\"11\\\" rx=\\\"2\\\"\\u003e\\u003c/rect\\u003e\\n                \\u003cpath d=\\\"M16 8V6a2 2 0 0 0-2-2H6a2 2 0 0 0-2 2v8a2 2 0 0 0 2 2h2\\\"\\u003e\\u003c/path\\u003e\\n              \\u003c/svg\\u003e\\n              \\u003csvg class=\\\"ccapi-home-icon-svg ccapi-home-copy-check\\\" viewBox=\\\"0 0 24 24\\\" aria-hidden=\\\"true\\\" focusable=\\\"false\\\"\\u003e\\n                \\u003cpath d=\\\"m5 12 4 4L19 6\\\"\\u003e\\u003c/path\\u003e\\n              \\u003c/svg\\u003e\\n              \\u003cspan class=\\\"ccapi-home-copy-label\\\"\\u003e\\u003cspan class=\\\"ccapi-home-i18n-zh\\\"\\u003e一键复制\\u003c/span\\u003e\\u003cspan class=\\\"ccapi-home-i18n-en\\\"\\u003eCopy URL\\u003c/span\\u003e\\u003c/span\\u003e\\n            \\u003c/button\\u003e\\n          \\u003c/div\\u003e\\n          \\u003cspan class=\\\"ccapi-home-api-focus-feedback\\\" data-ccapi-feedback aria-live=\\\"polite\\\"\\u003e\\u003cspan class=\\\"ccapi-home-i18n-zh\\\"\\u003e也可以手动选中地址后复制。\\u003c/span\\u003e\\u003cspan class=\\\"ccapi-home-i18n-en\\\"\\u003eYou can also select and copy the address manually.\\u003c/span\\u003e\\u003c/span\\u003e\\n        \\u003c/div\\u003e\\n      \\u003c/div\\u003e\\n    \\u003c/div\\u003e\\n  \\u003c/section\\u003e\\n\\n  \\u003csection class=\\\"ccapi-home-cta-section ccapi-home-reveal\\\" aria-labelledby=\\\"ccapi-home-cta-title\\\"\\u003e\\n    \\u003cdiv class=\\\"ccapi-home-shell\\\"\\u003e\\n      \\u003cdiv class=\\\"ccapi-home-cta\\\"\\u003e\\n        \\u003cdiv class=\\\"ccapi-home-cta-particles\\\" aria-hidden=\\\"true\\\"\\u003e\\u003c/div\\u003e\\n        \\u003cdiv class=\\\"ccapi-home-cta-content\\\"\\u003e\\n          \\u003ch2 class=\\\"ccapi-home-cta-title\\\" id=\\\"ccapi-home-cta-title\\\"\\u003e\\u003cspan class=\\\"ccapi-home-i18n-zh\\\"\\u003e现在开始使用 CC API\\u003c/span\\u003e\\u003cspan class=\\\"ccapi-home-i18n-en\\\"\\u003eStart building with CC API\\u003c/span\\u003e\\u003c/h2\\u003e\\n          \\u003cp class=\\\"ccapi-home-cta-text\\\"\\u003e\\u003cspan class=\\\"ccapi-home-i18n-zh\\\"\\u003e创建账户，获取 API Key，快速完成你的第一次调用。\\u003c/span\\u003e\\u003cspan class=\\\"ccapi-home-i18n-en\\\"\\u003eCreate an account, get your API Key, and make your first call in minutes.\\u003c/span\\u003e\\u003c/p\\u003e\\n          \\u003cdiv class=\\\"ccapi-home-cta-actions\\\"\\u003e\\n            \\u003ca class=\\\"ccapi-home-button ccapi-home-button--primary\\\" href=\\\"/register\\\" data-ccapi-link=\\\"start\\\"\\u003e\\n              \\u003cspan\\u003e\\u003cspan class=\\\"ccapi-home-i18n-zh\\\"\\u003e立即注册\\u003c/span\\u003e\\u003cspan class=\\\"ccapi-home-i18n-en\\\"\\u003eCreate Account\\u003c/span\\u003e\\u003c/span\\u003e\\n              \\u003csvg class=\\\"ccapi-home-icon-svg ccapi-home-button-arrow\\\" viewBox=\\\"0 0 24 24\\\" aria-hidden=\\\"true\\\" focusable=\\\"false\\\"\\u003e\\n                \\u003cpath d=\\\"M5 12h14\\\"\\u003e\\u003c/path\\u003e\\n                \\u003cpath d=\\\"m13 6 6 6-6 6\\\"\\u003e\\u003c/path\\u003e\\n              \\u003c/svg\\u003e\\n            \\u003c/a\\u003e\\n            \\u003ca class=\\\"ccapi-home-button ccapi-home-button--secondary\\\" href=\\\"/dashboard\\\" data-ccapi-link=\\\"console\\\"\\u003e\\n              \\u003cspan\\u003e\\u003cspan class=\\\"ccapi-home-i18n-zh\\\"\\u003e进入控制台\\u003c/span\\u003e\\u003cspan class=\\\"ccapi-home-i18n-en\\\"\\u003eGo to Dashboard\\u003c/span\\u003e\\u003c/span\\u003e\\n              \\u003csvg class=\\\"ccapi-home-icon-svg ccapi-home-button-arrow\\\" viewBox=\\\"0 0 24 24\\\" aria-hidden=\\\"true\\\" focusable=\\\"false\\\"\\u003e\\n                \\u003cpath d=\\\"M5 12h14\\\"\\u003e\\u003c/path\\u003e\\n                \\u003cpath d=\\\"m13 6 6 6-6 6\\\"\\u003e\\u003c/path\\u003e\\n              \\u003c/svg\\u003e\\n            \\u003c/a\\u003e\\n          \\u003c/div\\u003e\\n        \\u003c/div\\u003e\\n      \\u003c/div\\u003e\\n    \\u003c/div\\u003e\\n  \\u003c/section\\u003e\\n\\n  \\u003caside class=\\\"ccapi-home-copy-help\\\" id=\\\"ccapi-home-copy-help\\\" popover aria-live=\\\"polite\\\" aria-labelledby=\\\"ccapi-home-copy-help-title\\\"\\u003e\\n    \\u003cspan class=\\\"ccapi-home-copy-help-icon\\\" aria-hidden=\\\"true\\\"\\u003e\\n      \\u003csvg class=\\\"ccapi-home-icon-svg\\\" viewBox=\\\"0 0 24 24\\\" aria-hidden=\\\"true\\\" focusable=\\\"false\\\"\\u003e\\n        \\u003cpath d=\\\"M12 9v4\\\"\\u003e\\u003c/path\\u003e\\n        \\u003cpath d=\\\"M12 17h.01\\\"\\u003e\\u003c/path\\u003e\\n        \\u003cpath d=\\\"M10.3 3.7 2.8 17a2 2 0 0 0 1.7 3h15a2 2 0 0 0 1.7-3L13.7 3.7a2 2 0 0 0-3.4 0Z\\\"\\u003e\\u003c/path\\u003e\\n      \\u003c/svg\\u003e\\n    \\u003c/span\\u003e\\n    \\u003cspan class=\\\"ccapi-home-copy-help-content\\\"\\u003e\\n      \\u003cstrong class=\\\"ccapi-home-copy-help-title\\\" id=\\\"ccapi-home-copy-help-title\\\"\\u003e\\n        \\u003cspan class=\\\"ccapi-home-i18n-zh\\\"\\u003e请手动复制地址\\u003c/span\\u003e\\n        \\u003cspan class=\\\"ccapi-home-i18n-en\\\"\\u003eCopy the address manually\\u003c/span\\u003e\\n      \\u003c/strong\\u003e\\n      \\u003cspan class=\\\"ccapi-home-copy-help-text\\\"\\u003e\\n        \\u003cspan class=\\\"ccapi-home-i18n-zh\\\"\\u003e页面安全策略已阻止自动复制。请拖选或长按页面中的 API 地址后复制；电脑端可双击地址，再按 Ctrl+C。\\u003c/span\\u003e\\n        \\u003cspan class=\\\"ccapi-home-i18n-en\\\"\\u003eThe page security policy blocked automatic copying. Select or long-press the API address, then copy it; on desktop, double-click the address and press Ctrl+C.\\u003c/span\\u003e\\n      \\u003c/span\\u003e\\n    \\u003c/span\\u003e\\n    \\u003cbutton class=\\\"ccapi-home-copy-help-close\\\" type=\\\"button\\\" popovertarget=\\\"ccapi-home-copy-help\\\" popovertargetaction=\\\"hide\\\"\\u003e\\n      \\u003cspan class=\\\"ccapi-home-i18n-zh\\\"\\u003e知道了\\u003c/span\\u003e\\n      \\u003cspan class=\\\"ccapi-home-i18n-en\\\"\\u003eGot it\\u003c/span\\u003e\\n    \\u003c/button\\u003e\\n  \\u003c/aside\\u003e\\n\\n  \\u003cscript\\u003e\\n    (function () {\\n      \\\"use strict\\\";\\n\\n      const ccapiCurrentScript = document.currentScript;\\n      const ccapiRootCandidates = document.querySelectorAll(\\\"#ccapi-home-root\\\");\\n      const ccapiRoot =\\n        (ccapiCurrentScript \\u0026\\u0026 typeof ccapiCurrentScript.closest === \\\"function\\\"\\n          ? ccapiCurrentScript.closest(\\\"#ccapi-home-root\\\")\\n          : null) ||\\n        ccapiRootCandidates[ccapiRootCandidates.length - 1] ||\\n        null;\\n      if (!ccapiRoot) {\\n        return;\\n      }\\n\\n      const ccapiExistingRoots = document.querySelectorAll(\\\"#ccapi-home-root\\\");\\n      ccapiExistingRoots.forEach(function (ccapiExistingRoot) {\\n        if (\\n          ccapiExistingRoot !== ccapiRoot \\u0026\\u0026\\n          typeof ccapiExistingRoot.ccapiHomeCleanup === \\\"function\\\"\\n        ) {\\n          ccapiExistingRoot.ccapiHomeCleanup();\\n        }\\n      });\\n\\n      if (typeof ccapiRoot.ccapiHomeCleanup === \\\"function\\\") {\\n        ccapiRoot.ccapiHomeCleanup();\\n      }\\n\\n      const CCAPI_LINKS = {\\n        start: \\\"/register\\\",\\n        console: \\\"/dashboard\\\",\\n        login: \\\"/login\\\",\\n        docs: \\\"/docs\\\"\\n      };\\n\\n      const ccapiJourneyScenarios = {\\n        chat: {\\n          name: \\\"智能对话请求\\\",\\n          prompt: \\\"\\\\\\\"你好，CC API\\\\\\\"\\\",\\n          ready: {\\n            zh: \\\"已选择智能对话场景，可以播放请求旅程。\\\",\\n            en: \\\"AI chat is selected. The request journey is ready.\\\"\\n          }\\n        },\\n        code: {\\n          name: \\\"代码辅助请求\\\",\\n          prompt: \\\"\\\\\\\"请解释这段函数的作用\\\\\\\"\\\",\\n          ready: {\\n            zh: \\\"已选择代码辅助场景，可以播放请求旅程。\\\",\\n            en: \\\"Code help is selected. The request journey is ready.\\\"\\n          }\\n        },\\n        summary: {\\n          name: \\\"内容整理请求\\\",\\n          prompt: \\\"\\\\\\\"请提炼这段内容的重点\\\\\\\"\\\",\\n          ready: {\\n            zh: \\\"已选择内容整理场景，可以播放请求旅程。\\\",\\n            en: \\\"Summarization is selected. The request journey is ready.\\\"\\n          }\\n        }\\n      };\\n\\n      const ccapiCleanupTasks = [];\\n      const ccapiCopyTimers = new Map();\\n      const ccapiJourneyTimers = new Set();\\n      const ccapiMotionQuery = window.matchMedia(\\\"(prefers-reduced-motion: reduce)\\\");\\n      const ccapiCanvas = ccapiRoot.querySelector(\\\".ccapi-home-particle-canvas\\\");\\n      const ccapiHero = ccapiRoot.querySelector(\\\".ccapi-home-hero\\\");\\n      const ccapiContext = ccapiCanvas ? ccapiCanvas.getContext(\\\"2d\\\") : null;\\n      let ccapiReducedMotion = ccapiMotionQuery.matches;\\n      let ccapiRafId = null;\\n      let ccapiResizeTimer = null;\\n      let ccapiParticles = [];\\n      let ccapiWidth = 0;\\n      let ccapiHeight = 0;\\n      let ccapiPixelRatio = 1;\\n      let ccapiPageVisible = !document.hidden;\\n      let ccapiMutationObserver = null;\\n      let ccapiHeroPointerRect = null;\\n      let ccapiActiveLanguage = \\\"zh\\\";\\n      const ccapiMouse = { x: 0, y: 0, active: false };\\n\\n      function ccapiAddEvent(ccapiTarget, ccapiType, ccapiHandler, ccapiOptions) {\\n        if (!ccapiTarget || !ccapiTarget.addEventListener) {\\n          return;\\n        }\\n        ccapiTarget.addEventListener(ccapiType, ccapiHandler, ccapiOptions);\\n        ccapiCleanupTasks.push(function () {\\n          ccapiTarget.removeEventListener(ccapiType, ccapiHandler, ccapiOptions);\\n        });\\n      }\\n\\n      function ccapiText(ccapiZhText, ccapiEnText) {\\n        return ccapiActiveLanguage === \\\"en\\\" ? ccapiEnText : ccapiZhText;\\n      }\\n\\n      function ccapiLocalizedValue(ccapiValue) {\\n        if (!ccapiValue || typeof ccapiValue !== \\\"object\\\") {\\n          return String(ccapiValue || \\\"\\\");\\n        }\\n        return ccapiActiveLanguage === \\\"en\\\" ? ccapiValue.en : ccapiValue.zh;\\n      }\\n\\n      function ccapiReadPreference(ccapiKey) {\\n        try {\\n          return window.localStorage.getItem(ccapiKey);\\n        } catch (ccapiError) {\\n          return null;\\n        }\\n      }\\n\\n      function ccapiWritePreference(ccapiKey, ccapiValue) {\\n        try {\\n          window.localStorage.setItem(ccapiKey, ccapiValue);\\n        } catch (ccapiError) {\\n          return;\\n        }\\n      }\\n\\n      function ccapiUpdatePreferenceLabels() {\\n        const ccapiThemeToggle = ccapiRoot.querySelector(\\\"[data-ccapi-theme-toggle]\\\");\\n        const ccapiThemeButton = ccapiRoot.querySelector(\\\".ccapi-home-theme-button\\\");\\n        if (ccapiThemeButton) {\\n          const ccapiDark = Boolean(ccapiThemeToggle \\u0026\\u0026 ccapiThemeToggle.checked);\\n          ccapiThemeButton.setAttribute(\\n            \\\"title\\\",\\n            ccapiDark\\n              ? ccapiText(\\\"切换为浅色主题\\\", \\\"Switch to light theme\\\")\\n              : ccapiText(\\\"切换为深色主题\\\", \\\"Switch to dark theme\\\")\\n          );\\n          ccapiThemeButton.setAttribute(\\n            \\\"aria-label\\\",\\n            ccapiDark\\n              ? ccapiText(\\\"切换为浅色主题\\\", \\\"Switch to light theme\\\")\\n              : ccapiText(\\\"切换为深色主题\\\", \\\"Switch to dark theme\\\")\\n          );\\n        }\\n      }\\n\\n      function ccapiApplyLanguage(ccapiLanguage, ccapiPersist) {\\n        ccapiActiveLanguage = ccapiLanguage === \\\"en\\\" ? \\\"en\\\" : \\\"zh\\\";\\n        ccapiRoot.setAttribute(\\\"lang\\\", ccapiActiveLanguage === \\\"en\\\" ? \\\"en\\\" : \\\"zh-CN\\\");\\n        ccapiRoot.setAttribute(\\\"data-ccapi-language\\\", ccapiActiveLanguage);\\n\\n        ccapiRoot.querySelectorAll(\\\"[data-ccapi-language]\\\").forEach(function (ccapiInput) {\\n          ccapiInput.checked =\\n            ccapiInput.getAttribute(\\\"data-ccapi-language\\\") === ccapiActiveLanguage;\\n        });\\n\\n        if (document.documentElement) {\\n          document.documentElement.setAttribute(\\n            \\\"lang\\\",\\n            ccapiActiveLanguage === \\\"en\\\" ? \\\"en\\\" : \\\"zh-CN\\\"\\n          );\\n        }\\n        if (ccapiPersist) {\\n          ccapiWritePreference(\\\"sub2api_locale\\\", ccapiActiveLanguage);\\n        }\\n        ccapiUpdatePreferenceLabels();\\n        ccapiRoot.dispatchEvent(new CustomEvent(\\\"ccapi-home-language-change\\\", {\\n          detail: { language: ccapiActiveLanguage }\\n        }));\\n      }\\n\\n      function ccapiApplyTheme(ccapiTheme, ccapiPersist) {\\n        const ccapiThemeToggle = ccapiRoot.querySelector(\\\"[data-ccapi-theme-toggle]\\\");\\n        const ccapiNormalizedTheme = ccapiTheme === \\\"dark\\\" ? \\\"dark\\\" : \\\"light\\\";\\n        if (ccapiThemeToggle) {\\n          ccapiThemeToggle.checked = ccapiNormalizedTheme === \\\"dark\\\";\\n        }\\n        ccapiRoot.setAttribute(\\\"data-ccapi-theme\\\", ccapiNormalizedTheme);\\n        if (document.documentElement) {\\n          document.documentElement.classList.toggle(\\n            \\\"dark\\\",\\n            ccapiNormalizedTheme === \\\"dark\\\"\\n          );\\n        }\\n        if (ccapiPersist) {\\n          ccapiWritePreference(\\\"theme\\\", ccapiNormalizedTheme);\\n        }\\n        ccapiUpdatePreferenceLabels();\\n      }\\n\\n      function ccapiInitPreferences() {\\n        const ccapiLanguageInputs = ccapiRoot.querySelectorAll(\\\"[data-ccapi-language]\\\");\\n        const ccapiThemeToggle = ccapiRoot.querySelector(\\\"[data-ccapi-theme-toggle]\\\");\\n        const ccapiSavedLanguage = ccapiReadPreference(\\\"sub2api_locale\\\");\\n        const ccapiSavedTheme = ccapiReadPreference(\\\"theme\\\");\\n        const ccapiDocumentLanguage =\\n          document.documentElement \\u0026\\u0026 document.documentElement.getAttribute(\\\"lang\\\");\\n        const ccapiInitialLanguage =\\n          ccapiSavedLanguage === \\\"en\\\" || ccapiSavedLanguage === \\\"zh\\\"\\n            ? ccapiSavedLanguage\\n            : (ccapiDocumentLanguage || \\\"\\\").toLowerCase().startsWith(\\\"en\\\")\\n              ? \\\"en\\\"\\n              : \\\"zh\\\";\\n        const ccapiInitialTheme =\\n          ccapiSavedTheme === \\\"dark\\\" || ccapiSavedTheme === \\\"light\\\"\\n            ? ccapiSavedTheme\\n            : document.documentElement \\u0026\\u0026\\n                document.documentElement.classList.contains(\\\"dark\\\")\\n              ? \\\"dark\\\"\\n              : \\\"light\\\";\\n\\n        ccapiApplyLanguage(ccapiInitialLanguage, false);\\n        ccapiApplyTheme(ccapiInitialTheme, false);\\n\\n        ccapiLanguageInputs.forEach(function (ccapiInput) {\\n          ccapiAddEvent(ccapiInput, \\\"change\\\", function () {\\n            if (ccapiInput.checked) {\\n              ccapiApplyLanguage(\\n                ccapiInput.getAttribute(\\\"data-ccapi-language\\\") || \\\"zh\\\",\\n                true\\n              );\\n            }\\n          });\\n        });\\n\\n        ccapiAddEvent(ccapiThemeToggle, \\\"change\\\", function () {\\n          ccapiApplyTheme(ccapiThemeToggle.checked ? \\\"dark\\\" : \\\"light\\\", true);\\n        });\\n      }\\n\\n      function ccapiSetLinks() {\\n        const ccapiLinks = ccapiRoot.querySelectorAll(\\\"[data-ccapi-link]\\\");\\n        ccapiLinks.forEach(function (ccapiLink) {\\n          const ccapiKey = ccapiLink.getAttribute(\\\"data-ccapi-link\\\");\\n          if (ccapiKey \\u0026\\u0026 CCAPI_LINKS[ccapiKey]) {\\n            ccapiLink.setAttribute(\\\"href\\\", CCAPI_LINKS[ccapiKey]);\\n          }\\n        });\\n      }\\n\\n      function ccapiFallbackCopy(ccapiText) {\\n        const ccapiTextarea = document.createElement(\\\"textarea\\\");\\n        ccapiTextarea.value = ccapiText;\\n        ccapiTextarea.setAttribute(\\\"readonly\\\", \\\"\\\");\\n        ccapiTextarea.setAttribute(\\\"aria-hidden\\\", \\\"true\\\");\\n        ccapiTextarea.style.position = \\\"absolute\\\";\\n        ccapiTextarea.style.left = \\\"-9999px\\\";\\n        ccapiTextarea.style.top = \\\"0\\\";\\n        ccapiTextarea.style.opacity = \\\"0\\\";\\n        ccapiRoot.appendChild(ccapiTextarea);\\n        ccapiTextarea.select();\\n        ccapiTextarea.setSelectionRange(0, ccapiTextarea.value.length);\\n\\n        let ccapiCopied = false;\\n        try {\\n          ccapiCopied = document.execCommand(\\\"copy\\\");\\n        } catch (ccapiError) {\\n          ccapiCopied = false;\\n        }\\n\\n        ccapiTextarea.remove();\\n        return ccapiCopied;\\n      }\\n\\n      function ccapiWriteClipboard(ccapiText) {\\n        if (\\n          navigator.clipboard \\u0026\\u0026\\n          typeof navigator.clipboard.writeText === \\\"function\\\" \\u0026\\u0026\\n          window.isSecureContext\\n        ) {\\n          return navigator.clipboard.writeText(ccapiText).then(function () {\\n            return true;\\n          }).catch(function () {\\n            return ccapiFallbackCopy(ccapiText);\\n          });\\n        }\\n        return Promise.resolve(ccapiFallbackCopy(ccapiText));\\n      }\\n\\n      function ccapiShowCopyHelp() {\\n        const ccapiCopyHelp = ccapiRoot.querySelector(\\\"#ccapi-home-copy-help\\\");\\n        if (ccapiCopyHelp \\u0026\\u0026 typeof ccapiCopyHelp.showPopover === \\\"function\\\") {\\n          try {\\n            ccapiCopyHelp.showPopover();\\n          } catch (ccapiError) {\\n            return;\\n          }\\n        }\\n      }\\n\\n      function ccapiHideCopyHelp() {\\n        const ccapiCopyHelp = ccapiRoot.querySelector(\\\"#ccapi-home-copy-help\\\");\\n        if (ccapiCopyHelp \\u0026\\u0026 typeof ccapiCopyHelp.hidePopover === \\\"function\\\") {\\n          try {\\n            ccapiCopyHelp.hidePopover();\\n          } catch (ccapiError) {\\n            return;\\n          }\\n        }\\n      }\\n\\n      function ccapiGetFeedback(ccapiButton) {\\n        const ccapiContainer =\\n          ccapiButton.closest(\\\".ccapi-home-api-focus-control\\\") ||\\n          ccapiButton.closest(\\\".ccapi-home-api-compact\\\") ||\\n          ccapiButton.closest(\\\".ccapi-home-step\\\");\\n        if (!ccapiContainer) {\\n          return null;\\n        }\\n        const ccapiParent = ccapiContainer.parentElement || ccapiContainer;\\n        return (\\n          ccapiParent.querySelector(\\\"[data-ccapi-feedback]\\\") ||\\n          ccapiContainer.querySelector(\\\"[data-ccapi-feedback]\\\")\\n        );\\n      }\\n\\n      function ccapiRestoreCopyButton(ccapiButton, ccapiOriginalLabel, ccapiFeedback, ccapiOriginalFeedback) {\\n        const ccapiLabel = ccapiButton.querySelector(\\\".ccapi-home-copy-label\\\");\\n        if (ccapiLabel) {\\n          ccapiLabel.innerHTML = ccapiOriginalLabel;\\n        }\\n        ccapiButton.classList.remove(\\\"ccapi-home-is-copied\\\");\\n        if (ccapiFeedback) {\\n          ccapiFeedback.innerHTML = ccapiOriginalFeedback;\\n        }\\n      }\\n\\n      function ccapiHandleCopy(ccapiButton, ccapiOriginalLabel, ccapiFeedback, ccapiOriginalFeedback) {\\n        const ccapiText = ccapiButton.getAttribute(\\\"data-ccapi-copy\\\") || \\\"https://api.xiebc.cc\\\";\\n        const ccapiLabel = ccapiButton.querySelector(\\\".ccapi-home-copy-label\\\");\\n        const ccapiExistingTimer = ccapiCopyTimers.get(ccapiButton);\\n        if (ccapiExistingTimer) {\\n          window.clearTimeout(ccapiExistingTimer);\\n          ccapiCopyTimers.delete(ccapiButton);\\n        }\\n        ccapiRestoreCopyButton(\\n          ccapiButton,\\n          ccapiOriginalLabel,\\n          ccapiFeedback,\\n          ccapiOriginalFeedback\\n        );\\n\\n        ccapiWriteClipboard(ccapiText).then(function (ccapiCopied) {\\n          if (!ccapiCopied) {\\n            ccapiButton.classList.remove(\\\"ccapi-home-is-copied\\\");\\n            if (ccapiLabel) {\\n              ccapiLabel.innerHTML = ccapiOriginalLabel;\\n            }\\n            if (ccapiFeedback) {\\n              ccapiFeedback.textContent = ccapiText(\\n                \\\"复制失败，请手动复制\\\",\\n                \\\"Copy failed. Please copy the address manually.\\\"\\n              );\\n            }\\n            ccapiShowCopyHelp();\\n            return;\\n          }\\n\\n          ccapiHideCopyHelp();\\n          ccapiButton.classList.add(\\\"ccapi-home-is-copied\\\");\\n          if (ccapiLabel) {\\n            ccapiLabel.textContent = ccapiText(\\\"已复制\\\", \\\"Copied\\\");\\n          }\\n          if (ccapiFeedback) {\\n            ccapiFeedback.textContent = ccapiText(\\n              \\\"地址已复制到剪贴板\\\",\\n              \\\"The address has been copied to your clipboard.\\\"\\n            );\\n          }\\n\\n          const ccapiTimer = window.setTimeout(function () {\\n            ccapiCopyTimers.delete(ccapiButton);\\n            ccapiRestoreCopyButton(\\n              ccapiButton,\\n              ccapiOriginalLabel,\\n              ccapiFeedback,\\n              ccapiOriginalFeedback\\n            );\\n          }, 2000);\\n          ccapiCopyTimers.set(ccapiButton, ccapiTimer);\\n        });\\n      }\\n\\n      function ccapiInitCopyButtons() {\\n        const ccapiButtons = ccapiRoot.querySelectorAll(\\\"[data-ccapi-copy]\\\");\\n        ccapiButtons.forEach(function (ccapiButton) {\\n          const ccapiLabel = ccapiButton.querySelector(\\\".ccapi-home-copy-label\\\");\\n          const ccapiFeedback = ccapiGetFeedback(ccapiButton);\\n          const ccapiOriginalLabel = ccapiLabel ? ccapiLabel.innerHTML : \\\"\\\";\\n          const ccapiOriginalFeedback = ccapiFeedback ? ccapiFeedback.innerHTML : \\\"\\\";\\n          ccapiAddEvent(ccapiButton, \\\"click\\\", function (ccapiEvent) {\\n            ccapiEvent.preventDefault();\\n            ccapiHandleCopy(\\n              ccapiButton,\\n              ccapiOriginalLabel,\\n              ccapiFeedback,\\n              ccapiOriginalFeedback\\n            );\\n          });\\n        });\\n      }\\n\\n      function ccapiClearJourneyTimers() {\\n        ccapiJourneyTimers.forEach(function (ccapiTimer) {\\n          window.clearTimeout(ccapiTimer);\\n        });\\n        ccapiJourneyTimers.clear();\\n      }\\n\\n      function ccapiScheduleJourney(ccapiCallback, ccapiDelay) {\\n        const ccapiTimer = window.setTimeout(function () {\\n          ccapiJourneyTimers.delete(ccapiTimer);\\n          ccapiCallback();\\n        }, ccapiDelay);\\n        ccapiJourneyTimers.add(ccapiTimer);\\n      }\\n\\n      function ccapiResetJourney(ccapiJourney, ccapiRunLabel, ccapiStages) {\\n        ccapiClearJourneyTimers();\\n        ccapiJourney.classList.remove(\\n          \\\"ccapi-home-journey-is-running\\\",\\n          \\\"ccapi-home-journey-is-complete\\\"\\n        );\\n        ccapiStages.forEach(function (ccapiStage) {\\n          ccapiStage.classList.remove(\\\"ccapi-home-stage-is-active\\\");\\n        });\\n        ccapiRunLabel.textContent = ccapiText(\\\"演示一次请求\\\", \\\"Run request demo\\\");\\n      }\\n\\n      function ccapiRunJourney(\\n        ccapiJourney,\\n        ccapiFlowToggle,\\n        ccapiRunLabel,\\n        ccapiStatus,\\n        ccapiStages\\n      ) {\\n        ccapiResetJourney(ccapiJourney, ccapiRunLabel, ccapiStages);\\n        ccapiFlowToggle.checked = true;\\n\\n        if (ccapiReducedMotion) {\\n          ccapiStages.forEach(function (ccapiStage) {\\n            ccapiStage.classList.add(\\\"ccapi-home-stage-is-active\\\");\\n          });\\n          ccapiJourney.classList.add(\\\"ccapi-home-journey-is-complete\\\");\\n          ccapiFlowToggle.checked = false;\\n          ccapiRunLabel.textContent = ccapiText(\\\"再演示一次\\\", \\\"Replay demo\\\");\\n          ccapiStatus.textContent = ccapiText(\\n            \\\"请求旅程演示完成，响应已返回。\\\",\\n            \\\"The request journey is complete and the response has returned.\\\"\\n          );\\n          return;\\n        }\\n\\n        ccapiJourney.classList.add(\\\"ccapi-home-journey-is-running\\\");\\n        ccapiRunLabel.textContent = ccapiText(\\\"请求流动中\\\", \\\"Request in motion\\\");\\n        ccapiStatus.textContent = ccapiText(\\n          \\\"客户端正在准备请求...\\\",\\n          \\\"The client is preparing the request...\\\"\\n        );\\n\\n        const ccapiJourneyUpdates = [\\n          {\\n            delay: 250,\\n            index: 0,\\n            text: ccapiText(\\\"客户端已准备请求。\\\", \\\"The client prepared the request.\\\")\\n          },\\n          {\\n            delay: 920,\\n            index: 1,\\n            text: ccapiText(\\\"请求已进入 CC API。\\\", \\\"The request entered CC API.\\\")\\n          },\\n          {\\n            delay: 1650,\\n            index: 2,\\n            text: ccapiText(\\\"模型服务正在处理内容。\\\", \\\"The model service is processing the content.\\\")\\n          },\\n          {\\n            delay: 2420,\\n            index: 3,\\n            text: ccapiText(\\\"响应正在返回客户端。\\\", \\\"The response is returning to the client.\\\")\\n          }\\n        ];\\n\\n        ccapiJourneyUpdates.forEach(function (ccapiUpdate) {\\n          ccapiScheduleJourney(function () {\\n            if (ccapiStages[ccapiUpdate.index]) {\\n              ccapiStages[ccapiUpdate.index].classList.add(\\\"ccapi-home-stage-is-active\\\");\\n            }\\n            ccapiStatus.textContent = ccapiUpdate.text;\\n          }, ccapiUpdate.delay);\\n        });\\n\\n        ccapiScheduleJourney(function () {\\n          ccapiJourney.classList.remove(\\\"ccapi-home-journey-is-running\\\");\\n          ccapiJourney.classList.add(\\\"ccapi-home-journey-is-complete\\\");\\n          ccapiFlowToggle.checked = false;\\n          ccapiRunLabel.textContent = ccapiText(\\\"再演示一次\\\", \\\"Replay demo\\\");\\n          ccapiStatus.textContent = ccapiText(\\n            \\\"演示完成，整个过程没有发送真实网络请求。\\\",\\n            \\\"Demo complete. No real network request was sent.\\\"\\n          );\\n        }, 3150);\\n      }\\n\\n      function ccapiInitJourney() {\\n        const ccapiJourney = ccapiRoot.querySelector(\\\"[data-ccapi-journey]\\\");\\n        if (!ccapiJourney) {\\n          return;\\n        }\\n\\n        const ccapiScenarioInputs = ccapiJourney.querySelectorAll(\\\"[data-ccapi-scenario]\\\");\\n        const ccapiFlowToggle = ccapiJourney.querySelector(\\\"[data-ccapi-flow-toggle]\\\");\\n        const ccapiRunLabel = ccapiJourney.querySelector(\\\"[data-ccapi-flow-label]\\\");\\n        const ccapiStatus = ccapiJourney.querySelector(\\\"[data-ccapi-flow-status]\\\");\\n        const ccapiStages = Array.from(ccapiJourney.querySelectorAll(\\\"[data-ccapi-flow-stage]\\\"));\\n\\n        if (\\n          !ccapiFlowToggle ||\\n          !ccapiRunLabel ||\\n          !ccapiStatus ||\\n          ccapiStages.length !== 4\\n        ) {\\n          return;\\n        }\\n\\n        ccapiScenarioInputs.forEach(function (ccapiInput) {\\n          ccapiAddEvent(ccapiInput, \\\"change\\\", function () {\\n            if (!ccapiInput.checked) {\\n              return;\\n            }\\n            const ccapiScenarioKey = ccapiInput.getAttribute(\\\"data-ccapi-scenario\\\");\\n            const ccapiScenario = ccapiJourneyScenarios[ccapiScenarioKey];\\n            if (!ccapiScenario) {\\n              return;\\n            }\\n\\n            ccapiFlowToggle.checked = false;\\n            ccapiResetJourney(ccapiJourney, ccapiRunLabel, ccapiStages);\\n            ccapiStatus.textContent = ccapiLocalizedValue(ccapiScenario.ready);\\n          });\\n        });\\n\\n        ccapiAddEvent(ccapiFlowToggle, \\\"change\\\", function () {\\n          if (ccapiFlowToggle.checked) {\\n            ccapiRunJourney(\\n              ccapiJourney,\\n              ccapiFlowToggle,\\n              ccapiRunLabel,\\n              ccapiStatus,\\n              ccapiStages\\n            );\\n          } else {\\n            ccapiResetJourney(ccapiJourney, ccapiRunLabel, ccapiStages);\\n            ccapiStatus.textContent = ccapiText(\\n              \\\"演示已重置，可以重新播放。\\\",\\n              \\\"The demo has been reset and is ready to replay.\\\"\\n            );\\n          }\\n        });\\n\\n        ccapiAddEvent(ccapiRoot, \\\"ccapi-home-language-change\\\", function () {\\n          ccapiFlowToggle.checked = false;\\n          ccapiResetJourney(ccapiJourney, ccapiRunLabel, ccapiStages);\\n          ccapiStatus.textContent = ccapiText(\\n            \\\"场景已准备，可以开始演示。\\\",\\n            \\\"The scenario is ready. Start the demo when you like.\\\"\\n          );\\n        });\\n\\n        ccapiCleanupTasks.push(function () {\\n          ccapiFlowToggle.checked = false;\\n          ccapiResetJourney(ccapiJourney, ccapiRunLabel, ccapiStages);\\n        });\\n      }\\n\\n      function ccapiInitCards() {\\n        const ccapiCards = ccapiRoot.querySelectorAll(\\\".ccapi-home-feature-card\\\");\\n        ccapiCards.forEach(function (ccapiCard) {\\n          let ccapiCardRect = null;\\n          let ccapiCardRafId = null;\\n          let ccapiCardX = 0;\\n          let ccapiCardY = 0;\\n          ccapiAddEvent(ccapiCard, \\\"pointerenter\\\", function () {\\n            ccapiCardRect = ccapiCard.getBoundingClientRect();\\n          });\\n          ccapiAddEvent(ccapiCard, \\\"pointermove\\\", function (ccapiEvent) {\\n            if (ccapiReducedMotion || ccapiEvent.pointerType === \\\"touch\\\") {\\n              return;\\n            }\\n            if (!ccapiCardRect) {\\n              ccapiCardRect = ccapiCard.getBoundingClientRect();\\n            }\\n            ccapiCardX = ccapiEvent.clientX - ccapiCardRect.left;\\n            ccapiCardY = ccapiEvent.clientY - ccapiCardRect.top;\\n            if (ccapiCardRafId === null) {\\n              ccapiCardRafId = window.requestAnimationFrame(function () {\\n                ccapiCardRafId = null;\\n                ccapiCard.style.setProperty(\\\"--ccapi-home-x\\\", ccapiCardX + \\\"px\\\");\\n                ccapiCard.style.setProperty(\\\"--ccapi-home-y\\\", ccapiCardY + \\\"px\\\");\\n              });\\n            }\\n          });\\n          ccapiAddEvent(ccapiCard, \\\"pointerleave\\\", function () {\\n            ccapiCardRect = null;\\n            if (ccapiCardRafId !== null) {\\n              window.cancelAnimationFrame(ccapiCardRafId);\\n              ccapiCardRafId = null;\\n            }\\n            ccapiCard.style.setProperty(\\\"--ccapi-home-x\\\", \\\"50%\\\");\\n            ccapiCard.style.setProperty(\\\"--ccapi-home-y\\\", \\\"50%\\\");\\n          });\\n          ccapiCleanupTasks.push(function () {\\n            if (ccapiCardRafId !== null) {\\n              window.cancelAnimationFrame(ccapiCardRafId);\\n              ccapiCardRafId = null;\\n            }\\n          });\\n        });\\n      }\\n\\n      function ccapiShowAllReveals() {\\n        const ccapiReveals = ccapiRoot.querySelectorAll(\\\".ccapi-home-reveal\\\");\\n        ccapiReveals.forEach(function (ccapiElement) {\\n          ccapiElement.classList.add(\\\"ccapi-home-is-visible\\\");\\n        });\\n      }\\n\\n      function ccapiInitReveal() {\\n        ccapiRoot.classList.add(\\\"ccapi-home-js\\\");\\n        if (ccapiReducedMotion || !(\\\"IntersectionObserver\\\" in window)) {\\n          ccapiShowAllReveals();\\n          return;\\n        }\\n\\n        const ccapiObserver = new IntersectionObserver(function (ccapiEntries, ccapiCurrentObserver) {\\n          ccapiEntries.forEach(function (ccapiEntry) {\\n            if (ccapiEntry.isIntersecting) {\\n              ccapiEntry.target.classList.add(\\\"ccapi-home-is-visible\\\");\\n              ccapiCurrentObserver.unobserve(ccapiEntry.target);\\n            }\\n          });\\n        }, {\\n          root: null,\\n          rootMargin: \\\"0px 0px -10% 0px\\\",\\n          threshold: 0.12\\n        });\\n\\n        const ccapiReveals = ccapiRoot.querySelectorAll(\\\".ccapi-home-reveal\\\");\\n        ccapiReveals.forEach(function (ccapiElement) {\\n          ccapiObserver.observe(ccapiElement);\\n        });\\n        ccapiCleanupTasks.push(function () {\\n          ccapiObserver.disconnect();\\n        });\\n      }\\n\\n      function ccapiIsMobileCanvas() {\\n        return ccapiWidth \\u003c 700;\\n      }\\n\\n      function ccapiCreateParticle() {\\n        let ccapiX = Math.random() * ccapiWidth;\\n        let ccapiY = Math.random() * ccapiHeight;\\n        const ccapiCenterX = ccapiWidth * 0.5;\\n        const ccapiCenterY = ccapiHeight * 0.48;\\n        const ccapiNearCenter =\\n          Math.abs(ccapiX - ccapiCenterX) \\u003c ccapiWidth * 0.25 \\u0026\\u0026\\n          Math.abs(ccapiY - ccapiCenterY) \\u003c ccapiHeight * 0.27;\\n\\n        if (ccapiNearCenter \\u0026\\u0026 Math.random() \\u003c 0.72) {\\n          ccapiX = Math.random() \\u003c 0.5\\n            ? Math.random() * ccapiWidth * 0.18\\n            : ccapiWidth * (0.82 + Math.random() * 0.18);\\n        }\\n\\n        const ccapiAngle = Math.random() * Math.PI * 2;\\n        const ccapiSpeed = 0.035 + Math.random() * 0.105;\\n        const ccapiColors = [\\n          \\\"37, 99, 235\\\",\\n          \\\"8, 127, 156\\\",\\n          \\\"37, 99, 235\\\",\\n          \\\"8, 127, 156\\\",\\n          \\\"109, 75, 231\\\"\\n        ];\\n\\n        return {\\n          x: ccapiX,\\n          y: ccapiY,\\n          vx: Math.cos(ccapiAngle) * ccapiSpeed,\\n          vy: Math.sin(ccapiAngle) * ccapiSpeed,\\n          radius: 0.55 + Math.random() * 1.05,\\n          alpha: 0.16 + Math.random() * 0.34,\\n          color: ccapiColors[Math.floor(Math.random() * ccapiColors.length)]\\n        };\\n      }\\n\\n      function ccapiResetParticles() {\\n        const ccapiArea = Math.max(1, ccapiWidth * ccapiHeight);\\n        let ccapiCount;\\n        if (ccapiWidth \\u003c 480) {\\n          ccapiCount = Math.min(30, Math.max(20, Math.round(ccapiArea / 20500)));\\n        } else if (ccapiWidth \\u003c 820) {\\n          ccapiCount = Math.min(44, Math.max(28, Math.round(ccapiArea / 22000)));\\n        } else {\\n          ccapiCount = Math.min(76, Math.max(42, Math.round(ccapiArea / 19500)));\\n        }\\n\\n        ccapiParticles = [];\\n        for (let ccapiIndex = 0; ccapiIndex \\u003c ccapiCount; ccapiIndex += 1) {\\n          ccapiParticles.push(ccapiCreateParticle());\\n        }\\n      }\\n\\n      function ccapiResizeCanvas() {\\n        if (!ccapiCanvas || !ccapiContext || !ccapiHero) {\\n          return;\\n        }\\n\\n        const ccapiRect = ccapiHero.getBoundingClientRect();\\n        ccapiWidth = Math.max(1, Math.round(ccapiRect.width));\\n        ccapiHeight = Math.max(1, Math.round(ccapiRect.height));\\n        const ccapiDeviceRatio = Math.min(window.devicePixelRatio || 1, 2);\\n        ccapiPixelRatio = ccapiWidth \\u003c 700 ? Math.min(ccapiDeviceRatio, 1.25) : ccapiDeviceRatio;\\n        ccapiCanvas.width = Math.round(ccapiWidth * ccapiPixelRatio);\\n        ccapiCanvas.height = Math.round(ccapiHeight * ccapiPixelRatio);\\n        ccapiCanvas.style.width = ccapiWidth + \\\"px\\\";\\n        ccapiCanvas.style.height = ccapiHeight + \\\"px\\\";\\n        ccapiContext.setTransform(ccapiPixelRatio, 0, 0, ccapiPixelRatio, 0, 0);\\n        ccapiResetParticles();\\n        ccapiDrawParticles(false);\\n      }\\n\\n      function ccapiDrawMouseGlow() {\\n        if (!ccapiContext || !ccapiMouse.active || ccapiIsMobileCanvas()) {\\n          return;\\n        }\\n        const ccapiGradient = ccapiContext.createRadialGradient(\\n          ccapiMouse.x,\\n          ccapiMouse.y,\\n          0,\\n          ccapiMouse.x,\\n          ccapiMouse.y,\\n          145\\n        );\\n        ccapiGradient.addColorStop(0, \\\"rgba(37, 99, 235, 0.05)\\\");\\n        ccapiGradient.addColorStop(0.46, \\\"rgba(8, 127, 156, 0.02)\\\");\\n        ccapiGradient.addColorStop(1, \\\"rgba(37, 99, 235, 0)\\\");\\n        ccapiContext.fillStyle = ccapiGradient;\\n        ccapiContext.fillRect(ccapiMouse.x - 145, ccapiMouse.y - 145, 290, 290);\\n      }\\n\\n      function ccapiMoveParticle(ccapiParticle) {\\n        if (ccapiReducedMotion) {\\n          return;\\n        }\\n\\n        if (ccapiMouse.active \\u0026\\u0026 !ccapiIsMobileCanvas()) {\\n          const ccapiDx = ccapiParticle.x - ccapiMouse.x;\\n          const ccapiDy = ccapiParticle.y - ccapiMouse.y;\\n          const ccapiDistanceSquared = ccapiDx * ccapiDx + ccapiDy * ccapiDy;\\n          const ccapiRadius = 105;\\n          if (ccapiDistanceSquared \\u003e 0.1 \\u0026\\u0026 ccapiDistanceSquared \\u003c ccapiRadius * ccapiRadius) {\\n            const ccapiDistance = Math.sqrt(ccapiDistanceSquared);\\n            const ccapiForce = (1 - ccapiDistance / ccapiRadius) * 0.28;\\n            ccapiParticle.x += (ccapiDx / ccapiDistance) * ccapiForce;\\n            ccapiParticle.y += (ccapiDy / ccapiDistance) * ccapiForce;\\n          }\\n        }\\n\\n        ccapiParticle.x += ccapiParticle.vx;\\n        ccapiParticle.y += ccapiParticle.vy;\\n\\n        if (ccapiParticle.x \\u003c -8) {\\n          ccapiParticle.x = ccapiWidth + 8;\\n        } else if (ccapiParticle.x \\u003e ccapiWidth + 8) {\\n          ccapiParticle.x = -8;\\n        }\\n\\n        if (ccapiParticle.y \\u003c -8) {\\n          ccapiParticle.y = ccapiHeight + 8;\\n        } else if (ccapiParticle.y \\u003e ccapiHeight + 8) {\\n          ccapiParticle.y = -8;\\n        }\\n      }\\n\\n      function ccapiDrawParticles(ccapiShouldMove) {\\n        if (!ccapiContext || !ccapiCanvas) {\\n          return;\\n        }\\n\\n        ccapiContext.clearRect(0, 0, ccapiWidth, ccapiHeight);\\n        ccapiDrawMouseGlow();\\n        const ccapiConnectionDistance = ccapiIsMobileCanvas() ? 68 : 96;\\n        const ccapiConnectionLimit = ccapiIsMobileCanvas() ? 1 : 2;\\n\\n        for (let ccapiIndex = 0; ccapiIndex \\u003c ccapiParticles.length; ccapiIndex += 1) {\\n          const ccapiParticle = ccapiParticles[ccapiIndex];\\n          if (ccapiShouldMove) {\\n            ccapiMoveParticle(ccapiParticle);\\n          }\\n\\n          ccapiContext.beginPath();\\n          ccapiContext.arc(ccapiParticle.x, ccapiParticle.y, ccapiParticle.radius, 0, Math.PI * 2);\\n          ccapiContext.fillStyle = \\\"rgba(\\\" + ccapiParticle.color + \\\", \\\" + ccapiParticle.alpha + \\\")\\\";\\n          ccapiContext.fill();\\n\\n          let ccapiConnections = 0;\\n          for (\\n            let ccapiOtherIndex = ccapiIndex + 1;\\n            ccapiOtherIndex \\u003c ccapiParticles.length \\u0026\\u0026 ccapiConnections \\u003c ccapiConnectionLimit;\\n            ccapiOtherIndex += 1\\n          ) {\\n            const ccapiOther = ccapiParticles[ccapiOtherIndex];\\n            const ccapiDx = ccapiParticle.x - ccapiOther.x;\\n            const ccapiDy = ccapiParticle.y - ccapiOther.y;\\n            const ccapiDistance = Math.sqrt(ccapiDx * ccapiDx + ccapiDy * ccapiDy);\\n            if (ccapiDistance \\u003c ccapiConnectionDistance) {\\n              const ccapiOpacity =\\n                (1 - ccapiDistance / ccapiConnectionDistance) *\\n                (ccapiIsMobileCanvas() ? 0.055 : 0.085);\\n              ccapiContext.beginPath();\\n              ccapiContext.moveTo(ccapiParticle.x, ccapiParticle.y);\\n              ccapiContext.lineTo(ccapiOther.x, ccapiOther.y);\\n              ccapiContext.strokeStyle = \\\"rgba(37, 99, 235, \\\" + ccapiOpacity + \\\")\\\";\\n              ccapiContext.lineWidth = 0.55;\\n              ccapiContext.stroke();\\n              ccapiConnections += 1;\\n            }\\n          }\\n        }\\n      }\\n\\n      function ccapiParticleFrame() {\\n        ccapiRafId = null;\\n        if (!ccapiPageVisible || ccapiReducedMotion || !ccapiRoot.isConnected) {\\n          return;\\n        }\\n        ccapiDrawParticles(true);\\n        ccapiRafId = window.requestAnimationFrame(ccapiParticleFrame);\\n      }\\n\\n      function ccapiStopParticles() {\\n        if (ccapiRafId !== null) {\\n          window.cancelAnimationFrame(ccapiRafId);\\n          ccapiRafId = null;\\n        }\\n      }\\n\\n      function ccapiStartParticles() {\\n        if (\\n          !ccapiContext ||\\n          !ccapiPageVisible ||\\n          ccapiReducedMotion ||\\n          ccapiRafId !== null ||\\n          !ccapiRoot.isConnected\\n        ) {\\n          if (ccapiReducedMotion) {\\n            ccapiDrawParticles(false);\\n          }\\n          return;\\n        }\\n        ccapiRafId = window.requestAnimationFrame(ccapiParticleFrame);\\n      }\\n\\n      function ccapiHandleResize() {\\n        if (ccapiResizeTimer !== null) {\\n          window.clearTimeout(ccapiResizeTimer);\\n        }\\n        ccapiResizeTimer = window.setTimeout(function () {\\n          ccapiResizeTimer = null;\\n          ccapiResizeCanvas();\\n          ccapiStopParticles();\\n          ccapiStartParticles();\\n        }, 160);\\n      }\\n\\n      function ccapiHandleVisibility() {\\n        ccapiPageVisible = !document.hidden;\\n        if (ccapiPageVisible) {\\n          ccapiStartParticles();\\n        } else {\\n          ccapiStopParticles();\\n        }\\n      }\\n\\n      function ccapiHandleMotionChange(ccapiEvent) {\\n        ccapiReducedMotion = ccapiEvent.matches;\\n        if (ccapiReducedMotion) {\\n          ccapiStopParticles();\\n          ccapiDrawParticles(false);\\n          ccapiShowAllReveals();\\n        } else {\\n          ccapiStartParticles();\\n        }\\n      }\\n\\n      function ccapiInitCanvas() {\\n        if (!ccapiCanvas || !ccapiContext || !ccapiHero) {\\n          return;\\n        }\\n\\n        ccapiResizeCanvas();\\n        ccapiAddEvent(window, \\\"resize\\\", ccapiHandleResize, { passive: true });\\n        ccapiAddEvent(document, \\\"visibilitychange\\\", ccapiHandleVisibility);\\n        ccapiAddEvent(ccapiHero, \\\"pointerenter\\\", function () {\\n          ccapiHeroPointerRect = ccapiHero.getBoundingClientRect();\\n        }, { passive: true });\\n        ccapiAddEvent(ccapiHero, \\\"pointermove\\\", function (ccapiEvent) {\\n          if (ccapiReducedMotion || ccapiEvent.pointerType === \\\"touch\\\" || ccapiWidth \\u003c 700) {\\n            return;\\n          }\\n          if (!ccapiHeroPointerRect) {\\n            ccapiHeroPointerRect = ccapiHero.getBoundingClientRect();\\n          }\\n          ccapiMouse.x = ccapiEvent.clientX - ccapiHeroPointerRect.left;\\n          ccapiMouse.y = ccapiEvent.clientY - ccapiHeroPointerRect.top;\\n          ccapiMouse.active = true;\\n        }, { passive: true });\\n        ccapiAddEvent(ccapiHero, \\\"pointerleave\\\", function () {\\n          ccapiMouse.active = false;\\n          ccapiHeroPointerRect = null;\\n        }, { passive: true });\\n\\n        if (typeof ccapiMotionQuery.addEventListener === \\\"function\\\") {\\n          ccapiAddEvent(ccapiMotionQuery, \\\"change\\\", ccapiHandleMotionChange);\\n        } else if (typeof ccapiMotionQuery.addListener === \\\"function\\\") {\\n          ccapiMotionQuery.addListener(ccapiHandleMotionChange);\\n          ccapiCleanupTasks.push(function () {\\n            ccapiMotionQuery.removeListener(ccapiHandleMotionChange);\\n          });\\n        }\\n\\n        ccapiStartParticles();\\n      }\\n\\n      function ccapiCleanup() {\\n        ccapiStopParticles();\\n        if (ccapiResizeTimer !== null) {\\n          window.clearTimeout(ccapiResizeTimer);\\n          ccapiResizeTimer = null;\\n        }\\n        ccapiCopyTimers.forEach(function (ccapiTimer) {\\n          window.clearTimeout(ccapiTimer);\\n        });\\n        ccapiCopyTimers.clear();\\n        ccapiClearJourneyTimers();\\n        ccapiCleanupTasks.splice(0).forEach(function (ccapiTask) {\\n          try {\\n            ccapiTask();\\n          } catch (ccapiError) {\\n            return;\\n          }\\n        });\\n        if (ccapiMutationObserver) {\\n          ccapiMutationObserver.disconnect();\\n          ccapiMutationObserver = null;\\n        }\\n        ccapiParticles = [];\\n        ccapiRoot.classList.remove(\\\"ccapi-home-js\\\");\\n        ccapiRoot.ccapiHomeCleanup = null;\\n      }\\n\\n      ccapiRoot.ccapiHomeCleanup = ccapiCleanup;\\n      ccapiInitPreferences();\\n      ccapiSetLinks();\\n      ccapiInitCopyButtons();\\n      ccapiInitJourney();\\n      ccapiInitCards();\\n      ccapiInitReveal();\\n      ccapiInitCanvas();\\n\\n      if (\\\"MutationObserver\\\" in window \\u0026\\u0026 ccapiRoot.parentNode) {\\n        ccapiMutationObserver = new MutationObserver(function () {\\n          if (!ccapiRoot.isConnected) {\\n            ccapiCleanup();\\n          }\\n        });\\n        ccapiMutationObserver.observe(ccapiRoot.parentNode, {\\n          childList: true\\n        });\\n      }\\n    })();\\n  \\u003c/script\\u003e\\n\\u003c/div\\u003e\\n\",\"compact_home_enabled\":false,\"hide_ccs_import_button\":false,\"purchase_subscription_enabled\":false,\"purchase_subscription_url\":\"\",\"table_default_page_size\":20,\"table_page_size_options\":[10,20,50],\"custom_menu_items\":[{\"id\":\"0868944e0df069bb\",\"label\":\"使用教程\",\"icon_svg\":\"\\u003c?xml version=\\\"1.0\\\" standalone=\\\"no\\\"?\\u003e\\u003c!DOCTYPE svg PUBLIC \\\"-//W3C//DTD SVG 1.1//EN\\\" \\\"http://www.w3.org/Graphics/SVG/1.1/DTD/svg11.dtd\\\"\\u003e\\u003csvg t=\\\"1783662932420\\\" class=\\\"icon\\\" viewBox=\\\"0 0 1376 1024\\\" version=\\\"1.1\\\" xmlns=\\\"http://www.w3.org/2000/svg\\\" p-id=\\\"6508\\\" xmlns:xlink=\\\"http://www.w3.org/1999/xlink\\\" width=\\\"268.75\\\" height=\\\"200\\\"\\u003e\\u003cpath d=\\\"M596.800316 1023.986434q-3.66285 0-7.447794-0.217058c-24.581792-1.356611-50.303136-9.048595-80.04005-17.934397-110.238211-32.789288-153.134251-29.397761-187.565038-26.630275-51.008574 4.069833-91.842566 15.926613-127.88772 26.345386-56.177262 16.279332-104.689672 30.293124-147.029502-6.783055C18.802629 974.239508 3.065941 934.6129 0.054264 880.972501V186.04851c0-91.313487 68.49529-165.750733 153.161384-167.093778a1093.645533 1093.645533 0 0 1 405.463899 0 151.831904 151.831904 0 0 1 108.094765 49.774058c28.990777 31.554772 44.958089 73.256995 44.958089 117.31972V879.683721c-3.147338 53.002792-18.870459 92.819325-46.748815 118.36431-19.00612 17.418885-41.403768 25.938403-68.18327 25.938403z m-243.376015-93.60616c69.187162 0 124.021379 16.360729 169.400017 29.845442 57.561005 17.161129 86.294026 24.418998 110.034719 2.713222 18.354947-16.821977 28.922947-45.58213 31.378413-85.466493V186.04851c0-32.165247-11.517627-62.404107-32.43657-85.