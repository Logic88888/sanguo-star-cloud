mobile\n- Fixed an issue where model status displayed incorrectly after a plan expired\n- Fixed an error when modifying model configuration while a task is running"}}},"receivePreviewUpdates":false,"autoDownloadAndInstallUpdates":true,"skippedElectronUpdateVersions":{},"settingsSyncFirstRunPromptHandled":true,"webRemoteControlExternalRelayDevice":{"deviceSid":"d_CSTgNkx2vnS52qfVJSdQW7"},"webRemoteControlLastEnabledContext":{"workspacePath":"C:\\Users\\llh04\\.zcode\\workspace\\default","initialTaskId":"sess_28f28821-3f65-4141-a351-db6f8d46f33e"}}
