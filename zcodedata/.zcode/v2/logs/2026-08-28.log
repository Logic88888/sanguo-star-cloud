ative;\\n      z-index: 2;\\n      min-width: 0;\\n      text-align: center;\\n    }\\n\\n    #ccapi-home-root .ccapi-home-journey-stage-node {\\n      display: inline-flex;\\n      align-items: center;\\n      justify-content: center;\\n      width: 52px;\\n      height: 52px;\\n      margin-bottom: 13px;\\n      border: 1px solid #cfdbe9;\\n      border-radius: 14px;\\n      color: #61718a;\\n      background: #ffffff;\\n      box-shadow: 0 2px 5px rgba(37, 61, 96, 0.06);\\n      transition: color 220ms ease, border-color 220ms ease, background 220ms ease, transform 220ms ease, box-shadow 220ms ease;\\n    }\\n\\n    #ccapi-home-root .ccapi-home-journey-stage.ccapi-home-stage-is-active .ccapi-home-journey-stage-node,\\n    #ccapi-home-root .ccapi-home-journey.ccapi-home-journey-is-complete .ccapi-home-journey-stage-node {\\n      color: #ffffff;\\n      border-color: #3c73d9;\\n      background: linear-gradient(135deg, #3c73d9, #238da8);\\n      box-shadow: 0 4px 8px rgba(37, 99, 235, 0.18);\\n      transform: translateY(-2px) scale(1.025);\\n    }\\n\\n    #ccapi-home-root .ccapi-home-flow-toggle:checked ~ .ccapi-home-journey-grid .ccapi-home-journey-stage:nth-child(1) .ccapi-home-journey-stage-node {\\n      animation: ccapi-home-journey-stage-activate 0.42s 0.18s cubic-bezier(0.22, 1, 0.36, 1) forwards;\\n    }\\n\\n    #ccapi-home-root .ccapi-home-flow-toggle:checked ~ .ccapi-home-journey-grid .ccapi-home-journey-stage:nth-child(2) .ccapi-home-journey-stage-node {\\n      animation: ccapi-home-journey-stage-activate 0.42s 0.88s cubic-bezier(0.22, 1, 0.36, 1) forwards;\\n    }\\n\\n    #ccapi-home-root .ccapi-home-flow-toggle:checked ~ .ccapi-home-journey-grid .ccapi-home-journey-stage:nth-child(3) .ccapi-home-journey-stage-node {\\n      animation: ccapi-home-journey-stage-activate 0.42s 1.58s cubic-bezier(0.22, 1, 0.36, 1) forwards;\\n    }\\n\\n    #ccapi-home-root .ccapi-home-flow-toggle:checked ~ .ccapi-home-journey-grid .ccapi-home-journey-stage:nth-child