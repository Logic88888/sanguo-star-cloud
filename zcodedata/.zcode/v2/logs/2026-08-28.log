ition: relative;\\n      display: inline-flex;\\n      align-items: center;\\n      justify-content: center;\\n      gap: 9px;\\n      min-height: 50px;\\n      padding: 0 21px;\\n      overflow: hidden;\\n      border: 1px solid transparent;\\n      border-radius: 13px;\\n      text-decoration: none;\\n      font-size: 14px;\\n      font-weight: 720;\\n      letter-spacing: 0.01em;\\n      cursor: pointer;\\n      transition: transform 180ms ease, border-color 180ms ease, background 180ms ease, color 180ms ease, box-shadow 180ms ease;\\n    }\\n\\n    #ccapi-home-root .ccapi-home-button::before {\\n      content: \\\"\\\";\\n      position: absolute;\\n      inset: 0;\\n      pointer-events: none;\\n      background: linear-gradient(115deg, transparent 24%, rgba(255, 255, 255, 0.2) 48%, transparent 72%);\\n      transform: translateX(-135%);\\n      transition: transform 620ms ease;\\n    }\\n\\n    #ccapi-home-root .ccapi-home-button:hover::before {\\n      transform: translateX(135%);\\n    }\\n\\n    #ccapi-home-root .ccapi-home-button:hover {\\n      transform: translateY(-2px);\\n    }\\n\\n    #ccapi-home-root .ccapi-home-button:active {\\n      transform: scale(0.975);\\n    }\\n\\n    #ccapi-home-root .ccapi-home-button--primary {\\n      color: #06111c;\\n      background: linear-gradient(105deg, #79a4ff 0%, #51ddff 54%, #75ebcf 112%);\\n      box-shadow:\\n        0 12px 32px rgba(56, 170, 255, 0.2),\\n        inset 0 1px 0 rgba(255, 255, 255, 0.5);\\n    }\\n\\n    #ccapi-home-root .ccapi-home-button--primary:hover {\\n      box-shadow:\\n        0 16px 38px rgba(56, 170, 255, 0.29),\\n        inset 0 1px 0 rgba(255, 255, 255, 0.55);\\n    }\\n\\n    #ccapi-home-root .ccapi-home-button--secondary {\\n      color: #dce6f7;\\n      border-color: rgba(255, 255, 255, 0.12);\\n      background: rgba(255, 255, 255, 0.045);\\n      box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.04);\\n    }\\n\\n    #ccapi-home-root .ccapi-home-button--secondary:hover {\\n    